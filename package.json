{
  "name": "alessandroluppi-it",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal website of Alessandro Luppi - software and AI engineering.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "pnpm generate && pnpm dlx firebase-tools deploy --only hosting",
    "emulate": "pnpm generate && pnpm dlx firebase-tools emulators:start --only hosting",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/sitemap": "^8.5.1",
    "nuxt": "^4.5.2",
    "nuxt-schema-org": "^6.3.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
